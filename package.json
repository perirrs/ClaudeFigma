{
  "name": "productivity-analyser",
  "version": "0.2.0",
  "description": "Chrome extension + cloud dashboard for recruitment team productivity tracking",
  "private": true,
  "workspaces": ["cloud"],
  "scripts": {
    "dev": "npm --workspace cloud run dev",
    "build": "npm --workspace cloud run build",
    "start": "npm --workspace cloud run start",
    "ext:build": "node extension/build.js",
    "ext:pack": "node extension/package.js"
  }
}
