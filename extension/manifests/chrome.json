{
  "manifest_version": 3,
  "name": "Productivity Analyser",
  "version": "0.5.0",
  "description": "Config-driven productivity tracker for teams. Tracks browsing time and platform activity. Everything stored locally — optional team sync.",
  "permissions": ["tabs", "activeTab", "storage", "idle", "alarms"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://www.naukri.com/*",
    "https://*.naukri.com/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://*.linkedin.com/*"],
      "js": ["content-linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.naukri.com/*", "https://*.naukri.com/*"],
      "js": ["content-naukri.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_title": "Productivity Analyser", "default_popup": "popup.html" },
  "options_page": "options.html",
  "storage": {
    "managed_schema": "managed-schema.json"
  },
  "icons": {}
}
