{
  "manifest_version": 3,
  "name": "Productivity Analyser",
  "version": "0.3.0",
  "description": "Tracks browsing time and recruiter activity on LinkedIn & Naukri. Everything stored locally — no server needed.",
  "permissions": ["tabs", "activeTab", "storage", "idle", "alarms"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://www.naukri.com/*",
    "https://*.naukri.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://*.linkedin.com/*"],
      "js": ["content-linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.naukri.com/*", "https://*.naukri.com/*"],
      "js": ["content-naukri.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_title": "Productivity Analyser", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "browser_specific_settings": {
    "gecko": {
      "id": "productivity-analyser@yourco.com",
      "strict_min_version": "115.0"
    }
  },
  "icons": {}
}
